{
  "name": "@jsdevlab/bem",
  "version": "1.0.1",
  "private": false,
  "description": "Framework-agnostic BEM (Block, Element, Modifier) class name builder",
  "keywords": ["bem", "class", "block", "element"],
  "repository": {
    "type": "git",
    "url": "https://github.com/jsdevlab/bem.git"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "README.zh-CN.md"],
  "scripts": {
    "build": "rslib",
    "changeset": "changeset",
    "check": "biome check --write",
    "dev": "rslib --watch",
    "format": "biome format --write",
    "prepare": "simple-git-hooks",
    "release": "changeset publish",
    "test": "tsc --noEmit && rstest",
    "test:watch": "rstest --watch",
    "version": "changeset version"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm check",
    "pre-push": "pnpm format"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@rslib/core": "^1.0.6",
    "@rstest/adapter-rslib": "^0.12.6",
    "@rstest/core": "^0.12.6",
    "@rstest/coverage-v8": "^0.12.6",
    "@types/node": "^24.13.3",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.19.0 <27.0.0",
      "onFail": "download"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
